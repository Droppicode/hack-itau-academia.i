# Chave da API Gemini usada pela IA.I (/api/chat). Sem ela, a trilha usa a montagem local e o chat fica indisponível.
GEMINI_API_KEY=
# Hosts extras aceitos pela /api/chat, separados por vírgula (ex.: meu-app.vercel.app)
ALLOWED_ORIGINS=
# Apenas para o script de convite por e-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=
